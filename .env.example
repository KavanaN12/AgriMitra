# ==============================================================================
# AgriMitra Platform Environment Configuration Template
# Pilot Region: Mandya District, Karnataka (7 Taluks)
# Languages: Kannada (kn) & English (en)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime & Environment
# ------------------------------------------------------------------------------
# Set to 'development', 'test', or 'production'
ENVIRONMENT=production
PORT=8000

# ------------------------------------------------------------------------------
# 2. Database Connection
# ------------------------------------------------------------------------------
# Production / Docker Compose (PostgreSQL 16):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrimitra_db
# In Docker Compose internal network:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/agrimitra_db
# Local development fallback without PostgreSQL:
# DATABASE_URL=sqlite:///./agrimitra.db

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
# Generate a strong 64-character secret key for JWT & session signature in production
# Linux/macOS: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_64_character_hex_key_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 4. Initial Platform Administrator (Mandya Extension Office)
# ------------------------------------------------------------------------------
ADMIN_INITIAL_PHONE=9845000000
ADMIN_INITIAL_PASSWORD=replace_with_strong_extension_office_password
ADMIN_FULL_NAME=Mandya Krishi Admin

# ------------------------------------------------------------------------------
# 5. Storage & File Uploads
# ------------------------------------------------------------------------------
# Path where frontend static dist is located
FRONTEND_DIST_DIR=/app/static
# Non-ephemeral persistent storage for uploaded produce & crop disease photos
UPLOAD_DIR=/app/uploads

# ------------------------------------------------------------------------------
# 6. PostgreSQL Container Credentials (used by Docker Compose)
# ------------------------------------------------------------------------------
POSTGRES_DB=agrimitra_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_postgres_password_for_docker

# ------------------------------------------------------------------------------
# 7. Frontend Build & Client Configuration
# ------------------------------------------------------------------------------
# Set to 'false' in production or live API testing; 'true' for offline MSW Mandya demonstration mode
VITE_USE_MSW=false
VITE_API_URL=/api/v1
